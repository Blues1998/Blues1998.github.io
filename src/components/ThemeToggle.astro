---
/* Theme Toggle - sun/moon icon */
---

<button
  class="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <span class="theme-icon sun">☀️</span>
  <span class="theme-icon moon">🌙</span>
</button>

<style>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    font-size: 1rem;
    line-height: 1;
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-icon {
    position: absolute;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .sun { opacity: 1; transform: rotate(0deg); }
  .moon { opacity: 0; transform: rotate(-90deg); }

  :global([data-theme="dark"]) .sun { opacity: 0; transform: rotate(90deg); }
  :global([data-theme="dark"]) .moon { opacity: 1; transform: rotate(0deg); }
</style>

<script is:inline>
  (function() {
    var LOG = "[ThemeToggle]";
    var TRANSITION_MS = 550;

    function bindToggle() {
    var btn = document.querySelector(".theme-toggle");
    if (!btn) {
      // Not an error here: some navigations (e.g. a cached back-navigation
      // restoring the page, see IntroSequence.astro for the full story on
      // why this script tag can't be relied on to simply re-run on its
      // own) fire astro:page-load before this runs, and other routes may
      // render no toggle at all momentarily. bindToggle() re-checks on
      // every astro:page-load regardless.
      return;
    }

    if (btn.getAttribute("data-theme-bound") === "true") {
      console.debug(LOG, "Toggle handler already attached.");
      return;
    }

    btn.setAttribute("data-theme-bound", "true");
    console.debug(LOG, "Binding click handler.", {
      initialThemeAttr: document.documentElement.getAttribute("data-theme"),
    });

    btn.addEventListener("click", function() {
      var html = document.documentElement;
      var current = html.getAttribute("data-theme");
      var next = current === "dark" ? "light" : "dark";

      console.debug(LOG, "Click detected.", {
        currentTheme: current,
        nextTheme: next,
      });

      try {
        html.classList.add("theme-transitioning");
        window.setTimeout(function() {
          html.classList.remove("theme-transitioning");
        }, TRANSITION_MS);
      } catch (err) {
        console.error(LOG, "Failed to apply transition class.", err);
      }

      try {
        html.setAttribute("data-theme", next);
        console.debug(LOG, "Applied data-theme on <html>.", {
          dataTheme: html.getAttribute("data-theme"),
        });
      } catch (err) {
        console.error(LOG, "Failed to set data-theme attribute.", err);
      }

      try {
        localStorage.setItem("theme", next);
        console.debug(LOG, "Persisted theme in localStorage.", {
          storedTheme: localStorage.getItem("theme"),
        });
      } catch (err) {
        console.error(LOG, "Failed to persist theme in localStorage.", err);
      }
    });
    }

    bindToggle();
    if (!window.__themeToggleListenerBound) {
      window.__themeToggleListenerBound = true;
      document.addEventListener("astro:page-load", bindToggle);
    }
  })();
</script>
