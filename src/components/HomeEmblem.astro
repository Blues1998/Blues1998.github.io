---
/* Three.js centerpiece for the homepage: a model of a carbon atom (6
   protons + 6 neutrons lit and shaded into a real clustered nucleus, 2
   electrons in the K shell, 4 in the L shell, both real shell counts, not
   an arbitrary decoration). Anchored toward the right of the hero, but the
   canvas spans the full hero so the outer shell's orbit can sweep left,
   behind the menu, rather than being boxed into its own column.

   Glow is done with additive sprites carrying their own alpha (a radial
   gradient baked into a canvas texture), not EffectComposer bloom: bloom's
   blurred halo doesn't reliably extend into pixels that started fully
   transparent, so on this alpha:true canvas it barely reads once composited
   over a light page background. Sprites with real alpha in the texture
   composite correctly in both themes. */
---

<div class="home-emblem" id="home-emblem" aria-hidden="true">
  <canvas id="home-emblem-canvas"></canvas>
</div>

<style>
  .home-emblem {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 900px) {
    .home-emblem {
      display: block;
    }
  }

  .home-emblem canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import * as THREE from "three";

  const LOG = "[HomeEmblem]";

  try {
    const container = document.getElementById("home-emblem");
    const canvasEl = document.getElementById("home-emblem-canvas") as HTMLCanvasElement | null;
    if (!container || !canvasEl) {
      throw new Error("Emblem container or canvas not found.");
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0, 9);

    function readVarColor(name: string, fallback: string): THREE.Color {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return new THREE.Color(raw || fallback);
    }

    function makeGlowTexture(): THREE.CanvasTexture {
      const size = 128;
      const c = document.createElement("canvas");
      c.width = size;
      c.height = size;
      const ctx = c.getContext("2d")!;
      const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      gradient.addColorStop(0, "rgba(255,255,255,1)");
      gradient.addColorStop(0.35, "rgba(255,255,255,0.45)");
      gradient.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, size, size);
      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    }
    const glowTexture = makeGlowTexture();

    function makeGlowSprite(scale: number, opacity: number): THREE.Sprite {
      const mat = new THREE.SpriteMaterial({
        map: glowTexture,
        color: readVarColor("--color-accent", "#7c8aff"),
        transparent: true,
        opacity,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });
      const sprite = new THREE.Sprite(mat);
      sprite.scale.set(scale, scale, 1);
      glowMats.push(mat);
      return sprite;
    }
    const glowMats: THREE.SpriteMaterial[] = [];

    // Anchor group: repositioned on resize so the nucleus sits toward the
    // right of the viewport while the outer shell's orbit can still sweep
    // left across the frame, behind the menu.
    const anchor = new THREE.Group();
    scene.add(anchor);

    const atomGroup = new THREE.Group();
    anchor.add(atomGroup);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);
    const keyLight = new THREE.PointLight(0xffffff, 55, 0, 2);
    keyLight.position.set(3, 4, 6);
    scene.add(keyLight);
    const rimLight = new THREE.PointLight(0xffffff, 18, 0, 2);
    rimLight.position.set(-4, -2, -3);
    scene.add(rimLight);

    // ---- Nucleus: 6 protons + 6 neutrons, lit and shaded so they read as
    // an actual packed cluster of spheres rather than a flat painted blob.
    // Kept small and tight, the shells are the main visual event. ----
    const nucleusGroup = new THREE.Group();
    atomGroup.add(nucleusGroup);

    const protonMat = new THREE.MeshStandardMaterial({
      color: readVarColor("--color-accent", "#7c8aff"),
      roughness: 0.35,
      metalness: 0.15,
    });
    const neutronMat = new THREE.MeshStandardMaterial({
      color: readVarColor("--color-muted", "#8b8e96"),
      roughness: 0.45,
      metalness: 0.1,
    });
    const nucleonGeo = new THREE.SphereGeometry(0.075, 14, 14);

    const PROTONS = 6;
    const NEUTRONS = 6;
    const NUCLEONS = PROTONS + NEUTRONS;
    const NUCLEUS_RADIUS = 0.1;

    for (let i = 0; i < NUCLEONS; i++) {
      // Fibonacci sphere lattice for an even packing, then a little jitter
      // so it reads as clustered matter, not a perfect geometric lattice.
      const y = 1 - (i / (NUCLEONS - 1)) * 2;
      const r = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = (1 + Math.sqrt(5)) * Math.PI * i;
      const jitter = 0.9 + ((i * 37) % 10) / 50;
      const x = Math.cos(theta) * r * jitter;
      const z = Math.sin(theta) * r * jitter;

      // Alternate rather than split into first-half/second-half: the
      // golden-angle spiral keeps consecutive indices spatially close, so
      // alternating interleaves protons and neutrons through the cluster.
      const isProton = i % 2 === 0;
      const nucleon = new THREE.Mesh(nucleonGeo, isProton ? protonMat : neutronMat);
      nucleon.position.set(x * NUCLEUS_RADIUS, y * NUCLEUS_RADIUS * jitter, z * NUCLEUS_RADIUS);
      nucleusGroup.add(nucleon);
    }

    const nucleusGlow = makeGlowSprite(0.6, 0.55);
    nucleusGroup.add(nucleusGlow);

    // ---- Electron shells: carbon's real configuration, 2 then 4 ----
    interface Shell {
      electronPivots: THREE.Group[];
      electronGlows: THREE.Sprite[];
      speed: number;
    }
    const shells: Shell[] = [];

    const shellDefs = [
      { electrons: 2, radius: 3.4, tiltXDeg: 68, tiltZDeg: 0, speed: 0.016 },
      { electrons: 4, radius: 6.5, tiltXDeg: 68, tiltZDeg: 95, speed: 0.009 },
    ];

    const ringMat = new THREE.MeshBasicMaterial({
      color: readVarColor("--color-accent", "#7c8aff"),
      transparent: true,
      opacity: 0.35,
    });
    const electronMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
    const electronGeo = new THREE.SphereGeometry(0.13, 12, 12);

    shellDefs.forEach((def) => {
      const pivot = new THREE.Group();
      pivot.rotation.x = THREE.MathUtils.degToRad(def.tiltXDeg);
      pivot.rotation.z = THREE.MathUtils.degToRad(def.tiltZDeg);
      atomGroup.add(pivot);

      const ringGeo = new THREE.TorusGeometry(def.radius, 0.01, 6, 128);
      const ring = new THREE.Mesh(ringGeo, ringMat);
      pivot.add(ring);

      const electronPivots: THREE.Group[] = [];
      const electronGlows: THREE.Sprite[] = [];
      for (let i = 0; i < def.electrons; i++) {
        const electronPivot = new THREE.Group();
        electronPivot.rotation.z = (i / def.electrons) * Math.PI * 2;
        pivot.add(electronPivot);

        const electron = new THREE.Mesh(electronGeo, electronMat);
        electron.position.x = def.radius;
        electronPivot.add(electron);

        const electronGlow = makeGlowSprite(1.05, 1);
        electronGlow.position.x = def.radius;
        electronPivot.add(electronGlow);

        electronPivots.push(electronPivot);
        electronGlows.push(electronGlow);
      }

      shells.push({ electronPivots, electronGlows, speed: def.speed });
    });

    function resize() {
      const rect = container!.getBoundingClientRect();
      const w = rect.width || 1;
      const h = rect.height || 1;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();

      // Convert "nucleus should sit ~68% across the viewport" into a world
      // space offset at the atom's depth, so the outer shell can still
      // sweep past the frame's left half, behind the menu.
      const distance = camera.position.z;
      const visibleHeight = 2 * distance * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2);
      const visibleWidth = visibleHeight * camera.aspect;
      const screenFraction = w >= 1200 ? 0.88 : 0.76;
      anchor.position.x = (screenFraction - 0.5) * visibleWidth;
    }
    resize();
    window.addEventListener("resize", resize);

    const themeObserver = new MutationObserver(() => {
      const accent = readVarColor("--color-accent", "#7c8aff");
      protonMat.color.copy(accent);
      neutronMat.color.copy(readVarColor("--color-muted", "#8b8e96"));
      ringMat.color.copy(accent);
      glowMats.forEach((m) => m.color.copy(accent));
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    let autoX = 0;
    let autoY = 0;
    let tiltX = 0;
    let tiltY = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let clock = 0;

    if (!reduceMotion) {
      window.addEventListener("mousemove", (e) => {
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        targetTiltY = nx * 0.45;
        targetTiltX = ny * 0.3;
      });
    }

    function animate() {
      clock += 0.016;
      autoY += 0.0014;
      autoX += 0.0005;
      tiltX += (targetTiltX - tiltX) * 0.05;
      tiltY += (targetTiltY - tiltY) * 0.05;
      atomGroup.rotation.set(autoX + tiltX, autoY + tiltY, 0);

      // Subtle breathing pulse and a slow glow flicker, matter and energy
      // that both feel alive rather than static.
      const pulse = 1 + Math.sin(clock * 0.9) * 0.04;
      nucleusGroup.scale.setScalar(pulse);
      nucleusGlow.material.opacity = 0.45 + Math.sin(clock * 1.3) * 0.12;

      shells.forEach((shell, shellIndex) => {
        shell.electronGlows.forEach((glow, i) => {
          const phase = clock * 2.1 + shellIndex * 1.7 + i * 1.1;
          glow.material.opacity = 0.75 + Math.sin(phase) * 0.25;
        });
        shell.electronPivots.forEach((pivot) => {
          pivot.rotation.z += shell.speed;
        });
      });

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    if (reduceMotion) {
      renderer.render(scene, camera);
    } else {
      requestAnimationFrame(animate);
    }
  } catch (err) {
    console.error(LOG, "Emblem failed to initialize, leaving pane empty.", err);
  }
</script>
