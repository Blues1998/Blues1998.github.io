---
/* Homepage as a scroll-driven spatial journey: a tall (800vh) scroll
   container with a sticky viewport-height panel pinned inside it. Scrolling
   through that container is read by HomeCosmos.astro every animation frame
   and drives the persisted cosmos camera physically through the same six
   objects the old menu only let you preview on hover - see the "Homepage
   spatial journey" block in HomeCosmos.astro's script for the camera side.
   One "leg" is the track's scrollable height divided by five, computed
   from this element's real height in both files rather than assumed to be
   a viewport, and most of each leg is spent held on a waypoint rather than
   travelling between them.
   This component owns only the UI: a contextual "02 / 06 · Projects"
   readout (which doubles as the click-to-enter link into that section's
   real page) and a minimal six-dot indicator (click-to-travel, scrolls to
   that waypoint and lets the same scroll-driven camera code follow along -
   see spec: "clicking a destination should trigger the SAME camera
   journey").

   The six-object cosmos scene itself only ever builds on desktop (see
   isDesktop in HomeCosmos.astro) and the journey depends on real scroll
   motion, so under reduced motion or below that same breakpoint this
   renders a plain single-screen link list instead (.home-menu-fallback) -
   the original menu, functionally unchanged - rather than a long empty
   scroll with nothing to show for it. */
const base = import.meta.env.BASE_URL;

const menuItems = [
  { label: "Playground", href: `${base}playground/`, cosmosKey: "playground", hardReload: true },
  { label: "Projects", href: `${base}projects/`, cosmosKey: "projects" },
  { label: "Photography", href: `${base}photography/`, cosmosKey: "photography" },
  { label: "Music", href: `${base}music/`, cosmosKey: "music" },
  { label: "About", href: `${base}about/`, cosmosKey: "about" },
  { label: "Contact", href: `${base}contact/`, cosmosKey: "contact" },
];
---

<!-- The journey is a scroll track whose only job is to drive a camera that
     JavaScript builds. Without JS there is no camera, so what ships is
     eight screens of empty scrolling with a single link at the top - the
     markup renders regardless, since it's static HTML. Same swap the
     scene-failed and narrow-viewport cases make, just declared where no
     script has to run to apply it. Inline and unscoped on purpose: Astro
     would otherwise defer this to a stylesheet the browser has to fetch,
     and these class names belong to this component anyway. -->
<noscript>
  <style is:inline>
    .home-journey { display: none !important; }
    .home-menu-fallback {
      display: flex !important;
      align-items: center;
      position: relative;
      z-index: 2;
      min-height: 100vh;
    }
  </style>
</noscript>

<div class="home-hero" id="home-hero">
  <div class="home-vignette" aria-hidden="true"></div>

  <div class="home-journey" id="home-journey" data-items={JSON.stringify(menuItems)}>
    <div class="home-journey-sticky">
      <div class="home-hero-inner">
        <div class="home-hero-content">
          <h1 class="home-kicker">Animesh Singh</h1>

          {/* All six names, stacked and scrolled past a fixed line rather
              than one name swapped in place. The neighbours are dimmed,
              softened and pushed off the line by the same journey position
              that drives the camera, so the page says "there is more below
              this" in its own right instead of relying on the visitor
              trying a scroll to find out. Only the one on the line is a
              real target; the rest are inert and out of the accessibility
              tree, which already has the full list in .home-journey-links
              below. */}
          <div class="home-journey-readout">
            <span class="home-journey-index" id="home-journey-index" aria-hidden="true">01 / 06</span>
            <div class="home-journey-reel" id="home-journey-reel">
              {menuItems.map((item, i) => (
                <a
                  class="home-journey-label"
                  data-index={i}
                  href={item.href}
                  data-cosmos-key={item.cosmosKey}
                  data-astro-reload={item.hardReload ? true : undefined}
                  aria-hidden={i === 0 ? undefined : "true"}
                  tabindex={i === 0 ? undefined : "-1"}
                >{item.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <nav class="home-journey-dots" aria-label="Jump to section">
        {menuItems.map((item, i) => (
          <button
            type="button"
            class="home-journey-dot"
            data-index={i}
            aria-label={`Travel to ${item.label}`}
            aria-current={i === 0 ? "true" : undefined}
          ></button>
        ))}
      </nav>

      {/* The journey shows one section name at a time, which means the
          homepage offers exactly one real link - and this page hides the
          site header, so there is no other way in. Sighted visitors scroll
          to the rest; a screen reader or a keyboard has nothing to scroll
          with and was simply stuck with whichever section the camera
          happened to be at.

          These are the same six destinations as plain links, out of the
          visual layout but in the accessibility tree and in tab order.
          They become visible on focus, so a sighted keyboard user sees
          where they are rather than chasing an invisible focus ring.
          Lives inside .home-journey so the media query that swaps to the
          fallback list removes it too - only ever one set of links. */}
      <nav class="home-journey-links" aria-label="Sections">
        <ul>
          {menuItems.map((item) => (
            <li>
              <a href={item.href} data-astro-reload={item.hardReload ? true : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <nav class="home-menu-fallback" aria-label="Main">
    <div class="home-hero-inner">
      <div class="home-hero-content">
        <h1 class="home-kicker">Animesh Singh</h1>
        <ul class="home-menu">
          {menuItems.map((item, i) => (
            <li>
              <a
                href={item.href}
                class="home-menu-item"
                data-cosmos-key={item.cosmosKey}
                data-astro-reload={item.hardReload ? true : undefined}
              >
                <span class="home-menu-index">{String(i + 1).padStart(2, "0")}</span>
                <span class="home-menu-label">{item.label}</span>
                <span class="home-menu-cursor" aria-hidden="true">&rsaquo;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</div>

<style>
  .home-hero {
    position: relative;
    /* Deliberately no overflow:hidden here - it would establish this as a
       scroll-clipping ancestor for the sticky panel below, which breaks
       position:sticky (the browser stops tracking real document scroll and
       the panel just scrolls away with the page instead of pinning). Nothing
       here actually overflows its box, so there was nothing to clip. */
    /* No opaque fill here: the cosmos scene is a persisted, fixed backdrop
       mounted in BaseLayout, behind this whole page. An opaque background
       on this element would paint over it and hide it on the homepage. */
    background: radial-gradient(
      ellipse at 30% 40%,
      color-mix(in srgb, var(--color-accent) 8%, transparent) 0%,
      transparent 60%
    );
  }

  /* Fixed, not absolute. This frames the *viewport* - it's the darkened
     border of the shot you're currently looking at. Absolute made it span
     the whole scroll track, so its gradient was centred 3800px down the
     page and every actual screenful was sampling some off-centre slice of
     one enormous ellipse: permanently over-darkened at the top and bottom
     of the journey, and never doing the job anywhere. */
  .home-vignette {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 85% 80% at 50% 50%,
      transparent 62%,
      color-mix(in srgb, var(--color-bg) 86%, black) 100%
    );
  }

  .home-hero-inner {
    position: relative;
    width: 100%;
    padding: 0 clamp(1.5rem, 8vw, 6rem);
  }

  .home-hero-content {
    width: 100%;
    max-width: 26rem;
    text-align: left;
  }

  .home-kicker {
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }

  /* ---- Journey mode: tall scroll track + sticky pinned panel ---- */
  /* Six waypoints across five legs, with the sticky panel taking the first
     100vh - so the scrollable range is 700vh and each leg is 140vh. That
     length is deliberate: most of a leg is spent held on a waypoint rather
     than travelling (see LEG_HOLD_START in HomeCosmos.astro), and a leg of
     only 100vh left the dwell too short to actually look at anything.
     HomeCosmos reads this element's real height rather than assuming a
     figure, so this stays the single place the length is decided. */
  .home-journey {
    position: relative;
    z-index: 2;
    height: calc(100vh * 8);
  }

  .home-journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }

  .home-journey-readout {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
  }

  .home-journey-index {
    font-size: var(--font-size-sm);
    letter-spacing: 0.15em;
    color: var(--color-border);
  }

  /* Five rows tall with the live one on the middle line, so the block
     reserves the space its neighbours occupy instead of letting them
     float up over the name above. Masked rather than clipped: a hard
     edge at the top and bottom would read as a scrolling window, and
     this is meant to read as depth. */
  .home-journey-reel {
    position: relative;
    height: 11rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 26%, #000 74%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 26%, #000 74%, transparent 100%);
  }

  .home-journey-label {
    position: absolute;
    top: 50%;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding-bottom: 0.2rem;
    font-size: var(--font-size-lg);
    letter-spacing: 0.03em;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transform-origin: 0 50%;
    /* Inert until it is the one on the line. Without this the softened
       rows above and below are still hit targets, so a click aimed at
       nothing in particular navigates somewhere unasked. */
    pointer-events: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .home-journey-label[data-current="true"] {
    pointer-events: auto;
  }

  .home-journey-label::after {
    content: "\2192";
    opacity: 0;
    color: var(--color-accent);
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .home-journey-label:hover,
  .home-journey-label:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    outline: none;
  }

  .home-journey-label:hover::after,
  .home-journey-label:focus-visible::after {
    opacity: 1;
    transform: translateX(0);
  }

  /* Out of the layout but not out of the accessibility tree: clipped to a
     1px box rather than display:none or visibility:hidden, both of which
     would take these out of tab order and defeat the point. */
  .home-journey-links {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
  }

  .home-journey-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2);
  }

  .home-journey-links a {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Focused: pull it back into view as an ordinary link, so tabbing
     through is legible rather than a hunt for an invisible target. */
  .home-journey-links a:focus-visible {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    margin: var(--space-2);
    padding: 0.5rem 0.9rem;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .home-journey-dots {
    position: fixed;
    z-index: 4;
    top: 50%;
    right: clamp(1.25rem, 3.5vw, 3rem);
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .home-journey-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    margin: 0;
    appearance: none;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .home-journey-dot:hover {
    border-color: var(--color-accent);
  }

  .home-journey-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .home-journey-dot[aria-current="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.4);
  }

  /* ---- Fallback mode: the original single-screen list ---- */
  .home-menu-fallback {
    display: none;
  }

  .home-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .home-menu-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: var(--font-size-lg);
    letter-spacing: 0.03em;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .home-menu li:first-child .home-menu-item {
    border-top: 1px solid var(--color-border);
  }

  .home-menu-index {
    font-size: var(--font-size-sm);
    color: var(--color-border);
    min-width: 1.6em;
    text-align: left;
  }

  .home-menu-label {
    flex: 1;
    text-align: left;
  }

  .home-menu-cursor {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 150ms ease;
    color: var(--color-accent);
  }

  .home-menu-item:hover,
  .home-menu-item:focus-visible {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
    text-decoration: none;
    outline: none;
  }

  .home-menu-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .home-menu-item:hover .home-menu-index,
  .home-menu-item:focus-visible .home-menu-index {
    color: var(--color-accent);
  }

  .home-menu-item:hover .home-menu-cursor,
  .home-menu-item:focus-visible .home-menu-cursor {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 480px) {
    .home-menu-item {
      font-size: var(--font-size-base);
    }
  }

  /* The journey depends on a tall scroll track and a camera that actually
     moves - below the breakpoint where the six-object scene even builds,
     or when the visitor has asked for less motion, that track would just
     be 600vh of scrolling with nothing responding. Swap to the plain list
     instead of degrading the animation piecemeal. */
  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .home-journey {
      display: none;
    }

    .home-menu-fallback {
      display: flex;
      align-items: center;
      position: relative;
      z-index: 2;
      min-height: 100vh;
    }
  }

  /* Same swap again, but driven by the scene itself rather than by media
     query: HomeCosmos.astro sets data-cosmos-failed on its persisted
     container if WebGL is unavailable or the scene throws during init.
     Without this the failure mode was eight screens of empty scrolling
     with a single link at the top of it - the journey UI is meaningless
     when there is no camera for it to drive. Selected from the cosmos
     element because that is the only node that knows, and it is a sibling
     of <main>; :global is required because it sits outside this
     component's own scope. */
  :global(#home-cosmos[data-cosmos-failed]) ~ :global(main) .home-journey {
    display: none;
  }

  :global(#home-cosmos[data-cosmos-failed]) ~ :global(main) .home-menu-fallback {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
    min-height: 100vh;
  }
</style>

<script is:inline>
  (function () {
    var LOG = "[HomeMenu:journey]";

    // Wires the fallback single-screen list's hover-preview and
    // click-to-warp behavior - identical to the pre-journey menu's own
    // wiring, just scoped to .home-menu-fallback. Guarded per-item so
    // re-running on every astro:page-load (browser back to "/" doesn't
    // reliably re-run this script tag's own top-level code) is a no-op
    // against already-wired nodes.
    function wireFallbackMenu() {
      try {
        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var items = document.querySelectorAll(".home-menu-fallback .home-menu-item[data-cosmos-key]:not([data-cosmos-wired])");
        items.forEach(function (item) {
          item.setAttribute("data-cosmos-wired", "true");
          var key = item.getAttribute("data-cosmos-key");

          if (!reduceMotion) {
            var focus = function () {
              document.dispatchEvent(new CustomEvent("cosmos:focus", { detail: { key: key } }));
            };
            var blur = function () {
              document.dispatchEvent(new CustomEvent("cosmos:blur"));
            };
            item.addEventListener("mouseenter", focus);
            item.addEventListener("mouseleave", blur);
            item.addEventListener("focus", focus);
            item.addEventListener("blur", blur);
          }

          // Reduced motion gets plain, immediate links: the warp is a
          // camera move plus a content dissolve, neither of which happens
          // there, so intercepting the click would only delay it.
          if (reduceMotion) return;

          item.addEventListener("click", function (ev) {
            if (ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
            ev.preventDefault();
            document.dispatchEvent(
              new CustomEvent("cosmos:warp", {
                detail: {
                  key: key,
                  href: item.getAttribute("href"),
                  // Playground runs its own separate Three.js scenes and
                  // needs a real document load rather than a client-side
                  // swap. It still gets the same departure - HomeCosmos
                  // just finishes it with location.href instead of
                  // navigate() (see the cosmos:warp handler there).
                  reload: item.hasAttribute("data-astro-reload"),
                },
              })
            );
          });
        });
      } catch (err) {
        console.error(LOG, "Failed to wire fallback menu.", err);
      }
    }

    // Wires the journey readout (contextual label + index, doubling as the
    // click-to-enter link) and the six-dot click-to-travel indicator. The
    // actual camera motion lives in HomeCosmos.astro, which reads
    // window.scrollY itself every animation frame - this only needs to
    // keep the text/href/current-dot in sync with that same scroll
    // position, and turn dot clicks into a real scrollTo (so the shared
    // scroll-driven camera code is what actually moves the view, matching
    // "clicking a destination should trigger the SAME camera journey").
    function wireJourney() {
      try {
        var root = document.getElementById("home-journey");
        var reel = document.getElementById("home-journey-reel");
        var indexEl = document.getElementById("home-journey-index");
        if (!root || !reel || !indexEl) return;
        if (root.getAttribute("data-cosmos-wired") === "true") return;
        root.setAttribute("data-cosmos-wired", "true");

        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var items = JSON.parse(root.getAttribute("data-items") || "[]");
        var dots = Array.prototype.slice.call(document.querySelectorAll(".home-journey-dot"));
        var lastIndex = -1;

        function clampIndex(i) {
          return Math.max(0, Math.min(items.length - 1, i));
        }

        // One leg of the journey in pixels. Derived from the track's own
        // height so it tracks the CSS above; HomeCosmos.astro computes the
        // same figure the same way, which is what keeps the readout naming
        // the object the camera is actually looking at.
        // Mirrors legLength() in HomeCosmos.astro, including its 0 case:
        // when this track is hidden (narrow viewport) offsetHeight is 0,
        // and dividing by the resulting single pixel reported the last
        // waypoint for any scroll position at all.
        function legLength() {
          var vh = window.innerHeight || 1;
          var scrollable = root.offsetHeight - vh;
          if (scrollable < vh * 0.5) return 0;
          return scrollable / (items.length - 1);
        }

        var labels = Array.prototype.slice.call(reel.querySelectorAll(".home-journey-label"));

        // The same dwell curve HomeCosmos.astro drives the camera with, so
        // the names hold still while the camera is parked and move while it
        // is actually travelling. A linear read of scroll would have the
        // list creeping continuously against a view that wasn't moving.
        var LEG_HOLD_START = 0.42;
        var LEG_HOLD_END = 0.8;

        function journeyPosition(leg) {
          var max = items.length - 1;
          var raw = Math.max(0, Math.min(max, window.scrollY / leg));
          var i = Math.floor(raw);
          var f = raw - i;
          var t = Math.max(0, Math.min(1, (f - LEG_HOLD_START) / (LEG_HOLD_END - LEG_HOLD_START)));
          return i + t * t * t * (t * (t * 6 - 15) + 10);
        }

        function update() {
          var leg = legLength();
          if (leg <= 0) return;
          var pos = journeyPosition(leg);
          // Row pitch taken from the rendered line rather than a constant,
          // so it follows the font size at any viewport without a second
          // place to keep in sync.
          var row = labels[0] ? labels[0].offsetHeight : 32;
          var pitch = row * 1.35;

          labels.forEach(function (el, i) {
            var d = i - pos;
            var ad = Math.abs(d);
            // Legible but plainly not the subject: two pixels of blur on a
            // word this size still reads at a glance, which is the whole
            // job - it has to say "Projects" to be an invitation.
            var blur = Math.min(ad, 2) * 2.2;
            var fade = ad <= 1 ? 1 - 0.7 * ad : Math.max(0, 0.3 * (1 - (ad - 1) / 1.5));
            el.style.transform =
              // Half a row back, not half a pitch: top:50% puts the box's
              // top edge on the centre line, and it's the text that should
              // sit on it.
              "translateY(" + (d * pitch - row / 2).toFixed(2) + "px) scale(" + (1 - Math.min(ad, 2) * 0.06).toFixed(3) + ")";
            el.style.opacity = fade.toFixed(3);
            el.style.filter = blur > 0.01 ? "blur(" + blur.toFixed(2) + "px)" : "none";
          });

          // Flip the readout at 0.6 of a leg rather than the midpoint:
          // that's the middle of the camera's actual transit window, so the
          // name changes while you're between objects instead of while
          // still parked.
          var idx = clampIndex(Math.floor(window.scrollY / leg + 0.4));
          if (idx === lastIndex) return;
          lastIndex = idx;

          indexEl.textContent = String(idx + 1).padStart(2, "0") + " / " + String(items.length).padStart(2, "0");
          labels.forEach(function (el, i) {
            if (i === idx) {
              el.setAttribute("data-current", "true");
              el.removeAttribute("aria-hidden");
              el.removeAttribute("tabindex");
            } else {
              el.removeAttribute("data-current");
              el.setAttribute("aria-hidden", "true");
              el.setAttribute("tabindex", "-1");
            }
          });

          dots.forEach(function (dot, i) {
            if (i === idx) dot.setAttribute("aria-current", "true");
            else dot.removeAttribute("aria-current");
          });
        }

        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            update();
            ticking = false;
          });
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();

        dots.forEach(function (dot, i) {
          dot.addEventListener("click", function () {
            var leg = legLength();
            if (leg <= 0) return;
            window.scrollTo({ top: i * leg, behavior: reduceMotion ? "auto" : "smooth" });
          });
        });

        // Bound to all six, though only the one on the line can be reached
        // - the rest are pointer-events:none and out of tab order. Cheaper
        // and less stateful than rebinding a single handler every time the
        // active row changes.
        labels.forEach(function (el) {
          el.addEventListener("click", function (ev) {
            if (reduceMotion) return;
            if (ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
            ev.preventDefault();
            document.dispatchEvent(
              new CustomEvent("cosmos:warp", {
                detail: {
                  key: el.getAttribute("data-cosmos-key"),
                  href: el.getAttribute("href"),
                  // Set on Playground, which needs a real document load -
                  // it still dives in, it just can't carry the WebGL
                  // context across (see the cosmos:warp handler in
                  // HomeCosmos.astro).
                  reload: el.hasAttribute("data-astro-reload"),
                },
              })
            );
          });
        });
      } catch (err) {
        console.error(LOG, "Failed to wire journey navigation.", err);
      }
    }

    function wireAll() {
      wireFallbackMenu();
      wireJourney();
    }

    wireAll();
    if (!window.__homeJourneyListenerBound) {
      window.__homeJourneyListenerBound = true;
      document.addEventListener("astro:page-load", wireAll);
    }
  })();
</script>
