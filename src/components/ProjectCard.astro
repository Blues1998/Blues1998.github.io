---
const { title, summary, href, tech, isPrivate } = Astro.props;
const base = import.meta.env.BASE_URL;

const isExternal = href ? /^https?:\/\//.test(href) : false;
// Ensure no double slashes on internal links; external links pass through as-is.
const resolvedHref = !href ? undefined : isExternal ? href : `${base}${href.replace(/^\//, "")}`;
---

<article class="project-card">
  <h3>
    {resolvedHref ? (
      isExternal ? (
        <a href={resolvedHref} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        <a href={resolvedHref}>{title}</a>
      )
    ) : (
      title
    )}
    {isPrivate && <span class="project-private-badge">Private</span>}
  </h3>

  <p class="project-meta">{summary}</p>

  {tech && tech.length > 0 && (
    <div class="tech-badges">
      {tech.map((t) => (
        <span class="tech-badge">{t}</span>
      ))}
    </div>
  )}
</article>
