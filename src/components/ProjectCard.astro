---
const { title, summary, href, tech, isPrivate } = Astro.props;
const base = import.meta.env.BASE_URL;

const isExternal = href ? /^https?:\/\//.test(href) : false;
// Ensure no double slashes on internal links; external links pass through as-is.
const resolvedHref = !href ? undefined : isExternal ? href : `${base}${href.replace(/^\//, "")}`;
---

{/* h2, not h3. Each card is a top-level item under the page's only <h1>
    ("Projects"), so h3 skipped a level and left the page announcing
    h1 -> h3 with nothing in between - which is what a screen reader user
    navigating by heading hears as a missing section. The card keeps its
    existing h3 appearance via .project-card h2 in components.css; this
    changes the outline, not the design. */}
<article class="project-card">
  <h2>
    {resolvedHref ? (
      isExternal ? (
        <a href={resolvedHref} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        <a href={resolvedHref}>{title}</a>
      )
    ) : (
      title
    )}
    {isPrivate && <span class="project-private-badge">Private</span>}
  </h2>

  <p class="project-meta">{summary}</p>

  {tech && tech.length > 0 && (
    <div class="tech-badges">
      {tech.map((t) => (
        <span class="tech-badge">{t}</span>
      ))}
    </div>
  )}
</article>
