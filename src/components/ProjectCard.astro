---
const { title, summary, href, tech, isPrivate } = Astro.props;
const base = import.meta.env.BASE_URL;

// Ensure no double slashes
const resolvedHref = href ? `${base}${href.replace(/^\//, "")}` : undefined;
---

<article class="project-card">
  <h3>
    {resolvedHref ? <a href={resolvedHref}>{title}</a> : title}
    {isPrivate && <span class="project-private-badge">Private</span>}
  </h3>

  <p class="project-meta">{summary}</p>

  {tech && tech.length > 0 && (
    <div class="tech-badges">
      {tech.map((t) => (
        <span class="tech-badge">{t}</span>
      ))}
    </div>
  )}
</article>
