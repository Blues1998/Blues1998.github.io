---
/* Boot-sequence homepage intro: name decodes in letter by letter, then
   dissolves into the real page. Plays once per tab session; respects
   prefers-reduced-motion; degrades to nothing without JS. */
const NAME = "ANIMESH SINGH";
const letters = NAME.split("");
---

<div id="intro-sequence" class="intro-sequence">
  <div class="intro-inner" aria-hidden="true">
    <div class="intro-name">
      {letters.map((ch) =>
        ch === " " ? (
          <span class="intro-letter intro-letter--space"></span>
        ) : (
          <span class="intro-letter" data-final={ch}>{ch}</span>
        )
      )}
    </div>
  </div>
  <button type="button" class="intro-skip">Skip intro</button>
</div>

<noscript>
  <style>
    #intro-sequence { display: none !important; }
    body.intro-active { overflow: auto !important; }
  </style>
</noscript>

<style>
  body.intro-active {
    overflow: hidden;
  }

  .intro-sequence {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background: #05050a;
    opacity: 1;
    transition: opacity 500ms ease;
  }

  .intro-sequence.intro-sequence--leaving {
    opacity: 0;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .intro-name {
    display: flex;
    align-items: baseline;
    gap: 0.1em;
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 6vw, 3rem);
    font-weight: 600;
    color: #f5f5f7;
    letter-spacing: 0.04em;
  }

  .intro-letter {
    display: inline-block;
    opacity: 0;
    color: #7c8aff;
  }

  .intro-letter--space {
    width: 0.55em;
  }

  .intro-letter--locked {
    opacity: 1;
    color: #f5f5f7;
    transition: color 250ms ease;
  }

  .intro-skip {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: #8b8e96;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    opacity: 0;
    transition: opacity 300ms ease, color 150ms ease;
  }

  .intro-skip:hover,
  .intro-skip:focus-visible {
    color: #f5f5f7;
  }

  .intro-skip.intro-skip--visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-sequence {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var LOG = "[IntroSequence]";
    var STAGGER_MS = 45;
    var SCRAMBLE_FRAMES = 6;
    var FRAME_MS = 30;
    var HOLD_MS = 900;
    var FAILSAFE_MS = 4500;
    var GLITCH_CHARS = "!<>-_/[]{}=+*^?#$%01";

    // With <ClientRouter /> active, navigating back to "/" can restore a
    // cached snapshot of this page without re-running this script tag at
    // all (observed: the intro's own top-level code never re-executes on
    // that path, leaving a stale, never-checked #intro-sequence sitting at
    // full opacity - a black-screen lockout). document itself is never
    // replaced by any navigation, so a listener bound to it once, here,
    // stays reliable regardless of how a given navigation restored the
    // page. Guarded so forward navigations back to "/" (which DO re-run
    // this script tag) don't stack a second listener.
    if (window.__introSequenceBound) return;
    window.__introSequenceBound = true;

    function runIntro() {
      var root = document.getElementById("intro-sequence");
      if (!root) return; // Not on "/", or already removed - nothing to do.

      try {
      var alreadySeen = false;
      try {
        alreadySeen = sessionStorage.getItem("introSeen") === "1";
      } catch (e) {
        console.debug(LOG, "sessionStorage unavailable.", e);
      }

      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (alreadySeen || reduceMotion) {
        console.debug(LOG, "Skipping intro.", { alreadySeen: alreadySeen, reduceMotion: reduceMotion });
        root.remove();
        document.body.classList.remove("intro-active");
        return;
      }

      document.body.classList.add("intro-active");

      var timers = [];
      function schedule(fn, delay) {
        var id = window.setTimeout(fn, delay);
        timers.push(id);
        return id;
      }
      function clearAllTimers() {
        timers.forEach(function (id) { window.clearTimeout(id); });
        timers = [];
      }

      var finished = false;
      function finish() {
        if (finished) return;
        finished = true;
        clearAllTimers();
        try {
          sessionStorage.setItem("introSeen", "1");
        } catch (e) {
          console.debug(LOG, "Could not persist introSeen.", e);
        }
        root.classList.add("intro-sequence--leaving");
        document.body.classList.remove("intro-active");
        schedule(function () {
          root.remove();
          console.debug(LOG, "Intro removed from DOM.");
        }, 550);
      }

      // Hard failsafe: never let a stalled animation trap a visitor on a black screen.
      schedule(finish, FAILSAFE_MS);

      function tryPlaySwell() {
        try {
          var Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          var ctx = new Ctx();
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(80, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 1.3);
          gain.gain.setValueAtTime(0.0001, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.9);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 2.1);
          osc.connect(gain).connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 2.2);
          osc.onended = function () {
            try { ctx.close(); } catch (e) {}
          };
          if (ctx.state === "suspended") {
            ctx.resume().catch(function () {
              console.debug(LOG, "Audio resume blocked by autoplay policy; playing silent.");
            });
          }
        } catch (err) {
          console.debug(LOG, "Audio swell unavailable.", err);
        }
      }

      var letterEls = root.querySelectorAll(".intro-letter");
      var lettersDone = 0;
      var totalScrambling = 0;

      letterEls.forEach(function (span, i) {
        var isSpace = span.classList.contains("intro-letter--space");
        var startDelay = i * STAGGER_MS;

        if (isSpace) {
          schedule(function () {
            span.classList.add("intro-letter--locked");
            lettersDone++;
          }, startDelay);
          return;
        }

        totalScrambling++;
        var finalChar = span.getAttribute("data-final") || span.textContent;
        var frame = 0;

        function tick() {
          if (frame === 0) {
            span.style.opacity = "1";
          }
          if (frame < SCRAMBLE_FRAMES) {
            span.textContent = GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)];
            frame++;
            schedule(tick, FRAME_MS);
          } else {
            span.textContent = finalChar;
            span.classList.add("intro-letter--locked");
            lettersDone++;
          }
        }

        schedule(tick, startDelay);
      });

      var lastLockMs = (letterEls.length - 1) * STAGGER_MS + SCRAMBLE_FRAMES * FRAME_MS;

      var skipBtn = root.querySelector(".intro-skip");
      schedule(function () {
        if (skipBtn) skipBtn.classList.add("intro-skip--visible");
      }, 400);

      schedule(finish, lastLockMs + HOLD_MS);

      tryPlaySwell();

      if (skipBtn) {
        skipBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          console.debug(LOG, "Skip button clicked.");
          finish();
        });
        schedule(function () {
          try { skipBtn.focus(); } catch (e) {}
        }, 0);
      }

      root.addEventListener("click", function (e) {
        if (e.target === skipBtn) return;
        console.debug(LOG, "Overlay clicked, skipping.");
        finish();
      });

      document.addEventListener("keydown", function onKey(e) {
        if (finished) {
          document.removeEventListener("keydown", onKey);
          return;
        }
        console.debug(LOG, "Key press, skipping.", { key: e.key });
        finish();
      });
      } catch (err) {
        console.error(LOG, "Intro sequence failed, removing to avoid blocking the page.", err);
        var fallbackRoot = document.getElementById("intro-sequence");
        if (fallbackRoot) fallbackRoot.remove();
        document.body.classList.remove("intro-active");
      }
    }

    runIntro();
    // Reliable across every navigation type (see the comment above), unlike
    // this script tag's own top-level execution.
    document.addEventListener("astro:page-load", runIntro);
  })();
</script>
