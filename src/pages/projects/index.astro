---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getPublicRepos, repoSlug, repoTech } from "../../lib/github";

const repos = await getPublicRepos();

// Sort: stars descending, then by most recently pushed
repos.sort((a, b) => {
  if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count;
  return new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime();
});

// Collect all unique tech tags across repos
const allTech = [...new Set(repos.flatMap(repoTech))].sort();
---

<BaseLayout
  title="Projects — Animesh Singh"
  description="Public engineering projects on GitHub."
>
  <section>
    <h1>Projects</h1>

    <p class="project-overview">
      {repos.length} public {repos.length === 1 ? "repo" : "repos"} on GitHub
    </p>

    {allTech.length > 0 && (
      <div class="filter-bar" id="filter-bar">
        <span class="filter-label">Filter:</span>
        {allTech.map((t) => (
          <button class="tech-badge filterable" data-tech={t} type="button">
            {t}
          </button>
        ))}
      </div>
    )}

    <div class="project-grid" id="project-grid">
      {repos.map((repo) => (
        <div
          class="project-card-wrapper"
          data-techs={JSON.stringify(repoTech(repo))}
        >
          <ProjectCard
            title={repo.name}
            summary={repo.description ?? "No description."}
            href={`/projects/${repoSlug(repo)}/`}
            tech={repoTech(repo)}
          />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const bar = document.getElementById("filter-bar");
      const grid = document.getElementById("project-grid");
      if (!bar || !grid) return;

      const buttons = bar.querySelectorAll(".filterable");
      const cards = grid.querySelectorAll(".project-card-wrapper");
      let activeTech = null;

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tech = btn.dataset.tech;
          if (activeTech === tech) {
            activeTech = null;
            btn.classList.remove("active");
          } else {
            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            activeTech = tech;
          }
          cards.forEach((card) => {
            const techs = JSON.parse(card.dataset.techs || "[]");
            card.classList.toggle("hidden", !!(activeTech && !techs.includes(activeTech)));
          });
        });
      });
    })();
  </script>
</BaseLayout>
