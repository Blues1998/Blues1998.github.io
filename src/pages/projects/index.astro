---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCuratedProjects } from "../../data/projects";

const projects = await getCuratedProjects();

// Collect all unique tech tags across the curated set
const allTech = [...new Set(projects.flatMap((p) => p.tech))].sort();
---

<BaseLayout
  title="Projects - Animesh Singh"
  description="Selected engineering projects: shipped products and public code."
>
  <section>
    <p class="page-kicker"><span class="page-kicker-index">02</span> / 06</p>
    <h1>Projects</h1>

    {/* Count and filters share one strip. Both are chrome for the grid
        rather than page content, and both sat directly on the scene where
        the solar system's near-white orbit rings cross - which measured
        1.3:1 against a 4.5:1 requirement. The adaptive shield behind the
        page cannot reach that case: it is a radial pool centred on the
        object, and these rings are thin bright lines spanning the entire
        frame, so there is no centre for it to sit on. A control group
        belongs on a surface anyway, which is what the cards below already
        do. */}
    <div class="project-toolbar">
      <p class="project-overview">
        {projects.length} selected {projects.length === 1 ? "project" : "projects"}
      </p>

      {allTech.length > 0 && (
        <div class="filter-bar" id="filter-bar">
          <span class="filter-label">Filter:</span>
          {allTech.map((t) => (
            <button class="tech-badge filterable" data-tech={t} type="button">
              {t}
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="project-grid" id="project-grid">
      {projects.map((p) => (
        <div
          class="project-card-wrapper"
          data-techs={JSON.stringify(p.tech)}
        >
          <ProjectCard
            title={p.title}
            summary={p.summary}
            href={p.href}
            tech={p.tech}
            isPrivate={p.isPrivate}
          />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const bar = document.getElementById("filter-bar");
      const grid = document.getElementById("project-grid");
      if (!bar || !grid) return;

      const buttons = bar.querySelectorAll(".filterable");
      const cards = grid.querySelectorAll(".project-card-wrapper");
      let activeTech = null;

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tech = btn.dataset.tech;
          if (activeTech === tech) {
            activeTech = null;
            btn.classList.remove("active");
          } else {
            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            activeTech = tech;
          }
          cards.forEach((card) => {
            const techs = JSON.parse(card.dataset.techs || "[]");
            card.classList.toggle("hidden", !!(activeTech && !techs.includes(activeTech)));
          });
        });
      });
    })();
  </script>
</BaseLayout>
