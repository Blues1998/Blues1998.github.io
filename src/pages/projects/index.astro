---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Sort: explicit order → title
projects.sort((a, b) => {
  if (a.data.order && b.data.order) {
    return a.data.order - b.data.order;
  }
  return a.data.title.localeCompare(b.data.title);
});

// Status counts
const statusCounts = projects.reduce(
  (acc, project) => {
    acc[project.data.status]++;
    return acc;
  },
  {
    "under-development": 0,
    finished: 0,
    archived: 0,
  }
);

// Collect all unique tech tags
const allTech = [...new Set(projects.flatMap((p) => p.data.tech || []))].sort();
---

<BaseLayout
  title="Projects — Animesh Singh"
  description="Selected engineering projects with context, trade-offs, and reflections."
>
  <section>
    <h1>Projects</h1>

    <p class="project-overview">
      Total: {projects.length} ·
      Finished: {statusCounts.finished} ·
      Under development: {statusCounts["under-development"]} ·
      Archived: {statusCounts.archived}
    </p>

    <!-- Tech filter -->
    {allTech.length > 0 && (
      <div class="filter-bar" id="filter-bar">
        <span class="filter-label">Filter:</span>
        {allTech.map((t) => (
          <button class="tech-badge filterable" data-tech={t} type="button">
            {t}
          </button>
        ))}
      </div>
    )}

    <div class="project-grid" id="project-grid">
      {projects.map((project) => (
        <div class="project-card-wrapper" data-techs={JSON.stringify(project.data.tech || [])}>
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            href={`/projects/${project.slug}/`}
            tech={project.data.tech}
          />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const bar = document.getElementById("filter-bar");
      const grid = document.getElementById("project-grid");
      if (!bar || !grid) return;

      const buttons = bar.querySelectorAll(".filterable");
      const cards = grid.querySelectorAll(".project-card-wrapper");
      let activeTech = null;

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tech = btn.dataset.tech;

          // Toggle filter
          if (activeTech === tech) {
            activeTech = null;
            btn.classList.remove("active");
          } else {
            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            activeTech = tech;
          }

          // Show/hide cards
          cards.forEach((card) => {
            const techs = JSON.parse(card.dataset.techs || "[]");
            if (!activeTech || techs.includes(activeTech)) {
              card.classList.remove("hidden");
            } else {
              card.classList.add("hidden");
            }
          });
        });
      });
    })();
  </script>
</BaseLayout>
