---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicRepos, getRepoReadme, repoSlug, repoTech } from "../../lib/github";
import { FEATURED_REPO_NAMES } from "../../data/projects";
import { marked } from "marked";

export async function getStaticPaths() {
  // Only build detail pages for repos curated onto the Projects page:
  // the rest stay unlisted rather than generating orphaned routes.
  const repos = (await getPublicRepos()).filter((r) => FEATURED_REPO_NAMES.includes(r.name));

  return await Promise.all(
    repos.map(async (repo) => {
      const readmeMd = await getRepoReadme(repo);
      // Normalize away em dashes site-wide, including in fetched README content.
      const readmeHtml = readmeMd ? await marked(readmeMd.replace(/—/g, "-")) : null;
      return {
        params: { slug: repoSlug(repo) },
        props: { repo, readmeHtml },
      };
    })
  );
}

const { repo, readmeHtml } = Astro.props;
const tech = repoTech(repo);
---

<BaseLayout
  title={`${repo.name} - Animesh Singh`}
  description={repo.description ?? repo.name}
>
  <section>
    <h1>{repo.name}</h1>

    {repo.description && <p>{repo.description}</p>}

    {tech.length > 0 && (
      <div class="tech-badges">
        {tech.map((t) => <span class="tech-badge">{t}</span>)}
      </div>
    )}

    <p class="repo-meta">
      {repo.stargazers_count > 0 && (
        <span>★ {repo.stargazers_count}</span>
      )}
      {repo.stargazers_count > 0 && (repo.homepage || repo.html_url) && (
        <span> · </span>
      )}
      <a href={repo.html_url} target="_blank" rel="noopener">
        View on GitHub →
      </a>
      {repo.homepage && (
        <>
          {" · "}
          <a href={repo.homepage} target="_blank" rel="noopener">
            Live →
          </a>
        </>
      )}
    </p>
  </section>

  {readmeHtml ? (
    <section>
      <article class="project-content readme-content" set:html={readmeHtml} />
    </section>
  ) : (
    <section>
      <p class="muted">No README found for this repository.</p>
    </section>
  )}
</BaseLayout>
