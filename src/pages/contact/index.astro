---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact - Animesh Singh"
  description="Ways to reach me."
>
  <section>
    <p class="page-kicker"><span class="page-kicker-index">06</span> / 06</p>
    <h1>Contact</h1>

    <p>
      I'm open to conversations around engineering work, collaboration, or
      thoughtful projects.
    </p>
  </section>

  <!-- A channel list rather than a bulleted list. This page is the site's
       call to action and had the least design on it: three list items in
       the dimmest grey available, with the label and the address running
       together on one line. Each row now leads with its channel in the
       readout voice and gives the address itself the emphasis. -->
  <section>
    <ul class="channels">
      <li>
        <span class="channel-label">Email</span>
        <a class="channel-value" href="mailto:animesh98388@gmail.com">
          animesh98388@gmail.com
        </a>
      </li>
      <li>
        <span class="channel-label">GitHub</span>
        <a
          class="channel-value"
          href="https://github.com/Blues1998"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/Blues1998
        </a>
      </li>
      <li>
        <span class="channel-label">LinkedIn</span>
        <a
          class="channel-value"
          href="https://www.linkedin.com/in/animesh-singh-profile/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Animesh Singh
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
