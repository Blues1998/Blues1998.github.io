---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Animesh Singh"
  description="Page not found."
>
  <section class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist, or it moved without leaving a note.</p>
    <div class="button-row">
      <a href="/" class="button">Back home</a>
      <a href="/projects/" class="button">View projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  /* Was --color-muted at 0.3 opacity, which on a flat background is a
     tasteful ghost and over the nebula this route actually parks in front
     of is close to invisible. It stays quiet - it is a numeral, not a
     message - but quiet by being small-tracked rather than nearly
     transparent. */
  .not-found h1 {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 2rem + 7vw, 6rem);
    letter-spacing: var(--track-title);
    line-height: 1;
    margin-bottom: var(--space-3);
    color: var(--color-muted);
  }

  .not-found p {
    font-size: var(--font-size-lg);
    color: var(--color-text-soft);
    margin-bottom: var(--space-4);
  }
</style>
