---
import PlaygroundLayout from "../../layouts/PlaygroundLayout.astro";
import EndlessDrive from "../../components/playground/EndlessDrive";
import "../../styles/experiment.css";
---

<PlaygroundLayout
  title="Endless Drive — Playground"
  description="A procedural road through rolling dusk hills. The landscape generates itself. You just drive."
>
  <div class="experiment-page">
    <nav class="experiment-nav">
      <a href="/playground" class="experiment-nav-back">← playground</a>
    </nav>

    <EndlessDrive client:only="react" />
  </div>
</PlaygroundLayout>

<style>
  .experiment-page {
    height: 100vh;
    overflow: hidden;
  }
</style>
