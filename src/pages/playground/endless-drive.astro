---
import PlaygroundLayout from "../../layouts/PlaygroundLayout.astro";
import EndlessDrive from "../../components/playground/EndlessDrive";
import "../../styles/experiment.css";
import "../../styles/wander.css";
---

<PlaygroundLayout
  title="Wander — Endless Drive — Playground"
  description="An endless, procedural scenic drive through the seasons — day/night, weather, and a full drive simulation, generated as you go."
>
  <div class="experiment-page">
    <nav class="experiment-nav">
      <a href="/playground" class="experiment-nav-back">← playground</a>
    </nav>

    <EndlessDrive client:only="react" />
  </div>
</PlaygroundLayout>

<style>
  .experiment-page {
    height: 100vh;
    overflow: hidden;
  }
</style>
