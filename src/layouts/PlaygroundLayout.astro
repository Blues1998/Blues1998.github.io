---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/playground.css";

const {
  title = "Playground - Animesh Singh",
  description = "An immersive lab of experiments, prototypes, and internet ideas.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/og-default.png", Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Animesh Singh - software engineer, photographer and musician" />
    <meta property="og:site_name" content="Animesh Singh" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Animesh Singh - software engineer, photographer and musician" />

    <!-- Same icon set as BaseLayout: these experiment pages are full-screen
         apps with their own <head>, and a visitor who lands on one directly
         should get the same tab mark as the rest of the site. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/images/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f1117" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- IBM Plex Mono is here because this layout imports tokens.css and
         base.css, so --font-mono resolves on these pages too - without the
         face, the playground would silently render the instrument voice in
         a system mono while every other route showed Plex. Manrope and the
         heavier Inter are the playground's own display faces and stay. -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="playground-page">
    <main class="playground-main">
      <slot />
    </main>
  </body>
</html>
