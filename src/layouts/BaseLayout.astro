---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomeCosmos from "../components/HomeCosmos.astro";

/* Import global styles */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/dark.css";

const {
  title = "Animesh Singh",
  description = "Personal site of Animesh Singh, software engineer, photographer, and musician.",
  hideChrome = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/og-default.png", Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme init (must be first in head to prevent FOUC) -->
    <script is:inline>
      (function() {
        var LOG = "[ThemeInit]";
        try {
          var t = localStorage.getItem("theme");
          console.debug(LOG, "Init start.", { storedTheme: t });

          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
            console.debug(LOG, "Applied stored theme.", { theme: t });
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.setAttribute("data-theme", "dark");
            console.debug(LOG, "Applied system dark theme.");
          } else {
            console.debug(LOG, "No stored or dark system theme, using light defaults.");
          }

          // Keep in sync if system theme changes while page is open (only when no manual override)
          window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function(e) {
            try {
              console.debug(LOG, "System theme changed.", { matchesDark: e.matches });
              if (!localStorage.getItem("theme")) {
                document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
                console.debug(LOG, "Applied system-driven theme change.", {
                  theme: e.matches ? "dark" : "light",
                });
              } else {
                console.debug(LOG, "Ignoring system change due to stored manual theme.");
              }
            } catch(err) {
              console.error(LOG, "Failed handling system theme change.", err);
            }
          });
        } catch(e) {
          console.error(LOG, "Theme initialization failed.", e);
        }
      })();
    </script>

    <!-- View Transitions: enables the persistent cosmos backdrop (see
         HomeCosmos.astro) to survive client-side navigation instead of
         being torn down and rebuilt on every page. On browsers without the
         native View Transitions API, "swap" keeps client-side routing
         (so persistence still works) without the native crossfade; never
         "none", which would silently disable persistence for those
         visitors. No-JS visitors are unaffected either way: every link
         here is still a real <a href>, so navigation just falls back to a
         normal full page load. -->
    <meta name="astro-view-transitions-fallback" content="swap" />
    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Animesh Singh" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Animesh Singh"
      href="/rss.xml"
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <HomeCosmos />

    {!hideChrome && <Header />}

    <main id="main" class={hideChrome ? "main-bare" : undefined}>
      <slot />
    </main>

    {!hideChrome && <Footer />}

    <!-- Hidden terminal trigger. Guarded: with <ClientRouter /> active,
         this inline script re-executes on every client-side navigation
         (only transition:persist elements are exempt), so without the
         guard each navigation would stack another listener on the
         never-swapped document, firing the handler once per accumulated
         listener on a single "~" press. -->
    <script is:inline>
      if (!window.__terminalShortcutBound) {
        window.__terminalShortcutBound = true;
        document.addEventListener("keydown", function(e) {
          if (e.key === "~" && !e.ctrlKey && !e.metaKey && !e.altKey) {
            var tag = (e.target.tagName || "").toLowerCase();
            if (tag !== "input" && tag !== "textarea" && !e.target.isContentEditable) {
              window.location.href = "/terminal/";
            }
          }
        });
      }
    </script>
  </body>
</html>
